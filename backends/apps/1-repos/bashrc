# cmux1 opt-in prompt wrapper. Native mode never reads this file.
#
# --rcfile replaces ~/.bashrc rather than adding to it, so load the user's first.
[[ -r "$HOME/.bashrc" ]] && source "$HOME/.bashrc"

# Set the prompt through PROMPT_COMMAND so a theme that rewrites PS1 each prompt
# does not win.
cmux1_prompt() {
  if [[ "$CMUX1_PROMPT" == "arrow" ]]; then
    PS1='\[\e[38;2;111;214;196m\]\u\[\e[0m\] \[\e[38;2;244;184;197m\]\h\[\e[0m\] \[\e[38;2;232;213;163m\]\w\[\e[0m\] \[\e[38;2;111;214;196m\]❯\[\e[0m\] '
  else
    PS1='\[\e[48;2;111;214;196m\]\[\e[38;2;11;14;19m\] \u \[\e[48;2;244;184;197m\]\[\e[38;2;111;214;196m\]\[\e[38;2;61;31;42m\] \h \[\e[48;2;232;213;163m\]\[\e[38;2;244;184;197m\]\[\e[38;2;58;48;32m\] \w \[\e[49m\]\[\e[38;2;232;213;163m\]\[\e[39m\] '
  fi
}
PROMPT_COMMAND="cmux1_prompt${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
cmux1_prompt
