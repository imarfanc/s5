{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/98f62cee78e85bfc47c62ed703777c6bc8794f1c/cli/schemas/config-file.v1.json",
  "lock": true,
  "node_modules_dir": false,
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.16",
    "@std/path": "jsr:@std/path@1.1.3"
  },
  "tasks": {
    "choose": "deno run -A _other/scripts/choose.ts",
    "dev": "deno run -A --env-file _other/scripts/serve.ts dev",
    "start": "deno run -A --env-file _other/scripts/serve.ts start",
    "test": "deno test -A --permit-no-files",
    "check": "deno fmt --check && deno lint && deno check --allow-import=www.val.town:443,jsr.io:443 _other/scripts/*.ts backends/**/*.ts shared/*.ts && deno test -A --permit-no-files && deno run -A _other/scripts/build-manifest.ts --check",
    "git:history": "deno run -A _other/scripts/git-history.ts",
    "icons": "deno run -A _other/scripts/build-icons.ts",
    "manifest": "deno run -A _other/scripts/build-manifest.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitAny": false,
    "lib": [
      "dom",
      "dom.iterable",
      "dom.asynciterable",
      "deno.ns",
      "deno.unstable"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "exclude": [
      "_other/blob/**",
      "_other/git/**",
      "Apps/**",
      "public/vendor/**",
      "**/.vt/**",
      ".vscode/**"
    ]
  },
  "lint": {
    "include": ["**/*.ts", "**/*.tsx", "deno:/https/esm.town/**/*"],
    "exclude": ["_other/git/**", "Apps/**", "public/vendor/**", "**/.vt/**", ".vscode/**"],
    "rules": {
      "exclude": ["no-explicit-any"]
    }
  },
  "experimental": {
    "unstable-node-globals": true,
    "unstable-temporal": true,
    "unstable-worker-options": true,
    "unstable-sloppy-imports": true
  }
}
